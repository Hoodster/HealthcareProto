API_OPENAI=
API_CLAUDE=

# --- Database ---
# Local dev (PostgreSQL on localhost):
# DB_URL=postgresql+psycopg2://user:pass@localhost:5432/mimic_demo
#
# Azure (fetch from Key Vault before migrations):
# DB_URL=postgresql+psycopg2://user:pass@your-server.postgres.database.azure.com:5432/healthcare_db?sslmode=require
DB_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Azure Key Vault (App Service prod — DB_URL often omitted; app builds URL from secrets)
KEY_VAULT_NAME=

# CORS (comma-separated origins for frontend)
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.azurewebsites.net

# --- RAG backend ---
# memory (default, in-process) | azure_search (prod)
RAG_BACKEND=memory
# AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
# AZURE_SEARCH_KEY=
# AZURE_SEARCH_INDEX=healthcare-rag

STORAGE_NAME=
STORAGE_KEY=
STORAGE_CONTAINER=
STORAGE_CONNECTION_STRING=
